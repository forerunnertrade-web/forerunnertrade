# ─── Chain RPCs ───────────────────────────────────────────────────────────────
# At least one chain must be enabled for the scanner to do anything.
# WS URL drives pool detection. HTTP URL drives the auditor (EVM only) and
# the enricher (EVM + Solana). Both required per chain you actually use.

# Ethereum (or any EVM L1/L2 — point at Base, Arbitrum, BSC, etc.)
ETH_ENABLED=true
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Solana — Helius free tier handles personal use comfortably.
# Public mainnet-beta will throttle within minutes; don't bother.
SOL_ENABLED=true
SOL_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOL_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Price oracle: pump.fun bonding-curve reads with multi-RPC failover.
#
# Why three RPCs: fresh pump.fun curves are not visible on the public RPC
# for 3-5 seconds after launch (slot lag). A paid RPC with staked
# connections sees them in 200-500ms. Round-19 data showed 100% slot-lag
# failure rate on public RPC for the first-second window. Multiple paid
# providers as primary + backup gives the curve independent chances to be
# visible AND provides failover when one provider rate-limits or errors.
#
# Order: primary tried first. If it returns "slot lag" (curve invisible)
# or errors out, the backup is tried, then the second backup. The first
# RPC that returns a usable batch wins.
#
# Recommended setup for live testing:
#   PRIMARY:   Helius paid (https://mainnet.helius-rpc.com/?api-key=...)
#   BACKUP:    Alchemy paid (https://solana-mainnet.g.alchemy.com/v2/...)
#   BACKUP2:   QuickNode paid (https://your-endpoint.solana-mainnet.quiknode.pro/...)
#
# If all three env vars are empty, falls through to SOL_HTTP_URL and
# finally to api.mainnet-beta.solana.com. Backward compatible.
SOL_PRICE_RPC_URL=https://api.mainnet-beta.solana.com
SOL_PRICE_RPC_URL_BACKUP=
SOL_PRICE_RPC_URL_BACKUP2=

# SUI — public fullnode works for dev. Drops connections every ~10 minutes;
# the scanner reconnects automatically. For stability use BlockVision/Shinami.
SUI_ENABLED=true
SUI_WS_URL=wss://fullnode.mainnet.sui.io:443
SUI_HTTP_URL=https://fullnode.mainnet.sui.io:443

# ─── Audit & enrichment knobs ─────────────────────────────────────────────────
# Score 0-100. Events scoring below this are filtered before the dashboard
# sees them. EVM auditor returns real scores; SOL/SUI return 50 (stub).
AUDIT_MIN_SCORE=70

# Set false to skip the 30-second sample window entirely. Signals will be
# broadcast immediately but with no liquidity / price-change / buyer data.
ENRICH_ENABLED=true

# Sample window length in seconds. 30 is the practical floor — shorter
# windows don't give enough time for organic buyers to show up. Going
# longer (60-90s) yields cleaner signal at the cost of alert latency.
ENRICH_WINDOW_SECONDS=30

# ─── DEXScreener trending feed (no API key needed) ────────────────────────────
# Polls DEXScreener every N seconds for recently boosted tokens. Free tier
# allows 60 requests/minute on this endpoint. Set false to disable entirely.
DEXSCREENER_ENABLED=true
DEXSCREENER_INTERVAL_SECONDS=60
# Comma-separated list of chain codes to include.
# Available: ETH, SOL, SUI, BASE, BSC, POLY, ARB
DEXSCREENER_CHAINS=ETH,SOL,BASE,BSC,POLY,ARB

# ─── Trending tokens as actionable signals ────────────────────────────────────
# When true, DEXScreener-trending tokens that pass the audit are also routed
# into the engine for paper trading — not just shown in the trending panel.
# Off by default because trending tokens have already moved before we see
# them; paper P&L on these will skew worse than on fresh launches.
#
# Use this when on-chain new-pool detection is producing too few signals to
# meaningfully test your strategy.
TRENDING_AS_SIGNAL=false
# Skip trending tokens whose pool was created more than this many hours ago.
# Older tokens are likely established coins (WBTC, USDC, established memes)
# that aren't what you want to trade in this harness. 24h is a sensible
# default; lower to 6 or 1 for "very fresh" focus.
TRENDING_MAX_AGE_HOURS=24
# Minimum liquidity (USD) before we'll burn an RPC call to audit a trending
# token. Without this, every trending poll burns ~30 audit RPCs on microcap
# scams, which hits the Helius free-tier 10 req/s limit fast. $10k cuts the
# audit-able set to ~10-20% of the feed which fits comfortably.
TRENDING_MIN_LIQ_USD=10000

# ─── Engine auto-start ───────────────────────────────────────────────────────
# When true, the engine begins ticking immediately on backend boot rather
# than waiting for a dashboard /control start click. This is the "bot"
# behavior — Railway redeploys / container restarts don't pause trading.
ENGINE_AUTOSTART=false

# ─── pump.fun scanner (Solana memecoin launchpad) ────────────────────────────
# When true, subscribes to PumpPortal's WebSocket (wss://pumpportal.fun)
# and feeds every new pump.fun token launch into the engine as a "pumpfun"
# source signal. Free, no API key, but unofficial — connection drops are
# auto-reconnected.
#
# These signals have no 30s buyer count or 1h price change at detection
# (you're seeing them within seconds of launch), so the engine's filter
# skips those checks for pumpfun source. Liquidity and audit-score still
# apply. Audit is auto-pass since pump.fun controls minting until
# graduation, so the usual SPL mint-authority check is meaningless.
#
# Expect volume: dozens of launches per minute during active Solana hours.
PUMPFUN_ENABLED=false

# ─── Optional alerts ──────────────────────────────────────────────────────────
# Leave blank to disable. Both are independent — fill either or both.
# Telegram chat ID: message your bot once, then visit
#   https://api.telegram.org/botYOUR_TOKEN/getUpdates
# and find "chat":{"id":...} in the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ─── API server ──────────────────────────────────────────────────────────────
# Default API_HOST is 0.0.0.0 (bind all interfaces), which works for both
# local dev and Railway/Docker/Heroku deployments. Override to 127.0.0.1
# only if you specifically want the API loopback-only on a multi-user
# machine. Most users should leave this commented out.
# API_HOST=0.0.0.0
API_PORT=8080

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of additional origins the frontend may connect from.
# Localhost dev URLs are always allowed without listing them here.
# Production: list your Vercel deployment URL(s), e.g.:
#   CORS_ORIGINS=https://forerunner-abc123.vercel.app,https://forerunner.vercel.app
CORS_ORIGINS=

# ─── Dashboard auth ──────────────────────────────────────────────────────────
# Shared bearer token. Frontend sends `Authorization: Bearer <token>` on every
# request. WebSocket clients send it as a `?token=` query string.
# Generate: openssl rand -hex 32
#
# If unset, auth is DISABLED — fine for local dev, NOT safe on a public URL.
# The backend will log a warning on startup when this is unset.
DASHBOARD_TOKEN=

# ─── Supabase (backend persistence) ──────────────────────────────────────────
# When set, the engine writes state to Supabase tables so it survives
# Railway redeploys and container restarts. When unset, state lives in
# Python memory only.
#
# IMPORTANT: this is the SERVICE_ROLE key, NOT the anon key.
# The service role bypasses Row Level Security, which is appropriate for
# a trusted backend writer. NEVER ship this key to the browser or commit
# it to git.
#
# Get it from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
