# Vite reads this file at dev/build time. Variables MUST be prefixed
# VITE_ to be exposed to browser code. Don't put secrets here — anything
# in this file is shipped to the user's browser. The Supabase anon key
# is public by design; row-level-security in the database protects data.

# ── Supabase (data persistence) ──────────────────────────────────────────────
# Leave both blank to use localStorage only.
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend WebSocket URL ────────────────────────────────────────────────────
# Local dev: leave blank (defaults to ws://localhost:8080/events)
# Production: set to your Railway URL with wss:// scheme. Browsers block
# plain ws:// from an https:// page (which Vercel always serves), so the
# scheme MUST be wss in prod, not ws.
#
# Example: VITE_BACKEND_WS_URL=wss://forerunner-backend-production.up.railway.app/events
VITE_BACKEND_WS_URL=

# ── Dashboard auth token ─────────────────────────────────────────────────────
# Must match DASHBOARD_TOKEN on the backend. Without this set, the dashboard
# can't reach the backend in production (every request returns 401).
# Generate a random one: openssl rand -hex 32
#
# Yes, this ends up in the shipped JS bundle — anyone who inspects your
# dashboard's network tab can read it. That's an acceptable level of security
# for a paper-trading dashboard with no real-money flows. If you ever add
# live trading, replace this with proper session-based auth.
VITE_DASHBOARD_TOKEN=

# After editing this file locally, restart `npm run dev`. Vite only
# reads .env at startup; hot-reload doesn't pick up env changes.
# On Vercel, env vars are configured in the project's Settings → Environment
# Variables — NOT from this file (the .env file is gitignored).
