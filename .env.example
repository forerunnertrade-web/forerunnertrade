# --- Ethereum (or any EVM L1/L2) ---
ETH_ENABLED=true
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Solana ---
SOL_ENABLED=true
SOL_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOL_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- SUI ---
SUI_ENABLED=true
SUI_WS_URL=wss://fullnode.mainnet.sui.io:443
SUI_HTTP_URL=https://fullnode.mainnet.sui.io:443

# --- Filters ---
MIN_LIQ_USD=5000
AUDIT_ENABLED=true

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
